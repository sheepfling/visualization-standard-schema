    "check:core": "npm --workspace reference/sdj_core_v0_1 run check",
    "check:v0_3": "npm --workspace reference/sdj_v0_5_advanced_cesium_profile/sdj_workbench_v0_3 run check && node reference/sdj_v0_5_advanced_cesium_profile/sdj_acceptance_runner_v0_5.mjs",
    "build:exposed-scenes": "npm --workspace reference/sdj_workbench_v0_2 run build:exposed-scenes",
