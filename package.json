    "smoke": "npm --workspace reference/sdj_workbench_v0_2 run smoke",
    "smoke:v0_3": "npm --workspace reference/sdj_v0_5_advanced_cesium_profile/sdj_workbench_v0_3 run smoke",
    "test": "npm --workspace reference/sdj_workbench_v0_2 run test",
    "test:v0_3": "npm --workspace reference/sdj_v0_5_advanced_cesium_profile/sdj_workbench_v0_3 run test",
