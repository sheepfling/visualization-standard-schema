SOAP_SCENARIO_FILE
DEFINE GROUP PLATFORM_GROUP  "{New}"
	PLATLIST "ON"
     ".Earth CI Observer"
     "Air"
     "END_OF_INPUT"
DEFINE PLATFORM AIRROUTE  "Air"
	STATE  2004 2 1 0 0 0 2004 2 11 0 0 0
  PLAT  "Earth"
  WAYPOINT_TYPE BY_SPEED
  WAYPOINT 33.93 -118.4 1 0 0.205778
  WAYPOINT 38.82 -104.72 1 0 0.205778
  SHAPE AIRCRAFT
  SMOOTH OFF
DEFINE TRAJECTORY  "Air Trajectory"
	CS  "ECR"
	PLATFORM  "Air"
	TRAJECTORY_CHOICE RELATIVE FORWARD 49000
		2001 4 10 0 0 0
		2001 4 10 1 1 1
	REFRESH_CHOICE GENERATE
