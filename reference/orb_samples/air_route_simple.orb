  CONES SET
	CONE_LIST
     "END_OF_INPUT"
  ICONS ON
	ICON_LIST "ON"
     "ABQ"
     "Air(Smooth)"
     "END_OF_INPUT"
  LABELS ON
	LABEL_LIST "ON"
     "Air(Smooth)"
     "END_OF_INPUT"
  VIEWANGLES -90 90
