SOAP_SCENARIO_FILE
DEFINE MAPCENTER
	MAPFILE wmedium.wld
DEFINE SPICE
	SPICEFILE leap.tls
	SPICEFILE constant.tpc
DEFINE CS CSBASIS  "ECR"
  AXES OFF
  TRACK Z LONLAT 0 90
  ALIGN RESULTANT Y LONLAT 0 0
  SWEEP Z NOSWEEP
  ORIGIN  ".Host Platform" ".Host Platform"
DEFINE ANALYSIS  ".GM Earth"
  VARIABLE CONSTANT 398600.5
    DISTANCEU KILOMETERS 3
    TIMEU SECONDS -2
    ANGLEU DEGREES 0
    COMMENT  "Earth GM"
  BOUNDS 0 10
  COLOR Red
DEFINE GRID CONTOUR  ".Earth Lat/Lon Grid"
  DIMENSION 8 8 10
	ALTITUDE 0
  DOMAIN 0 86400
	DOMDLT 300
